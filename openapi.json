{
  "openapi": "3.0.3",
  "info": {
    "title": "团队任务台 API",
    "version": "1.1.0",
    "description": "给一个小组看今天有哪些事、谁在做、做到哪了。\n\n- 需要登录：除健康检查、注册、登录外，所有接口都要带 `Authorization: Bearer <token>`。\n- 注册、登录、退出、当前用户四个接口组成用户系统；第一个注册的账号自动成为管理员。\n- 任务固定四个业务字段：标题、负责人、优先级、状态，另带创建人 `created_by` / `creator`。\n- 任务台是团队共享的：登录后能看到所有任务；删除只允许创建人或管理员。\n- 状态流转：待办 `todo` → 进行中 `doing` → 完成 `done`。\n- 时间均为 UTC，ISO 8601 格式，例如 `2026-01-31T09:30:00.123Z`。\n- 所有响应都带 CORS 头，前端可直接跨域调用。"
  },
  "servers": [
    {
      "url": "/",
      "description": "当前部署实例"
    },
    {
      "url": "http://47.108.60.176",
      "description": "测试环境"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "注册、登录、退出、当前用户"
    },
    {
      "name": "users",
      "description": "团队成员"
    },
    {
      "name": "tasks",
      "description": "任务读取、新建、改状态"
    },
    {
      "name": "system",
      "description": "健康检查"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "system"
        ],
        "operationId": "health",
        "summary": "健康检查",
        "description": "确认服务是否在线，部署后可用于探活。不需要登录。",
        "security": [],
        "responses": {
          "200": {
            "description": "服务正常",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "register",
        "summary": "注册",
        "description": "创建账号并直接返回登录 token，前端不用再调一次登录。第一个注册的账号自动成为 `admin`，之后注册的都是 `member`。用户名为 3–32 位字母、数字、点、下划线或短横线，不区分大小写唯一；密码至少 8 位。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "username": "zhangsan",
                "password": "secret123",
                "display_name": "张三"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "注册成功，已登录",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "409": {
            "description": "用户名已存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "login",
        "summary": "登录",
        "description": "账号密码换 token。token 有效期 7 天，请求时放在 `Authorization: Bearer <token>`。",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              },
              "example": {
                "username": "zhangsan",
                "password": "secret123"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "登录成功",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "401": {
            "description": "账号或密码错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "operationId": "logout",
        "summary": "退出登录",
        "description": "注销当前 token，之后再用它请求会返回 401。",
        "responses": {
          "204": {
            "description": "已退出"
          },
          "401": {
            "description": "未登录或 token 已失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "operationId": "currentUser",
        "summary": "当前登录用户",
        "description": "前端启动时用它判断登录态是否还在。",
        "responses": {
          "200": {
            "description": "当前用户",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 已失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "get": {
        "tags": [
          "users"
        ],
        "operationId": "listUsers",
        "summary": "团队成员列表",
        "description": "给「负责人」下拉框用。需要登录，不返回密码。",
        "responses": {
          "200": {
            "description": "用户列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserList"
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 已失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "tags": [
          "tasks"
        ],
        "operationId": "listTasks",
        "summary": "任务列表",
        "description": "按创建时间倒序返回任务，可按状态、负责人、创建人过滤。需要登录。",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "只看某个状态",
            "schema": {
              "$ref": "#/components/schemas/TaskStatus"
            }
          },
          {
            "name": "assignee",
            "in": "query",
            "required": false,
            "description": "只看某个负责人（精确匹配）",
            "schema": {
              "type": "string",
              "example": "张三"
            }
          },
          {
            "name": "mine",
            "in": "query",
            "required": false,
            "description": "只看自己创建的：传 `1` / `true` / `yes`",
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "true",
                "yes"
              ],
              "example": "1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "任务列表",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskList"
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 已失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "过滤参数不合法",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "tasks"
        ],
        "operationId": "createTask",
        "summary": "新建任务",
        "description": "标题和负责人必填。优先级默认 `medium`，状态默认 `todo`。创建人取当前登录用户。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskCreate"
              },
              "example": {
                "title": "把登录页的联调做完",
                "assignee": "张三",
                "priority": "high"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "创建成功",
            "headers": {
              "Location": {
                "description": "新任务的地址",
                "schema": {
                  "type": "string",
                  "example": "/api/tasks/1"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 已失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/tasks/{taskId}": {
      "parameters": [
        {
          "name": "taskId",
          "in": "path",
          "required": true,
          "description": "任务 id",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          }
        }
      ],
      "get": {
        "tags": [
          "tasks"
        ],
        "operationId": "getTask",
        "summary": "任务详情",
        "responses": {
          "200": {
            "description": "任务详情",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 已失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "任务不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "tasks"
        ],
        "operationId": "updateTask",
        "summary": "改任务（主要是改状态）",
        "description": "只传要改的字段。把状态从 `todo` 改成 `doing`，再改成 `done`。字段会先校验再落库，失败时整条不变。团队共享，任何登录用户都能改。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskUpdate"
              },
              "examples": {
                "startWork": {
                  "summary": "开始做",
                  "value": {
                    "status": "doing"
                  }
                },
                "finish": {
                  "summary": "标记完成",
                  "value": {
                    "status": "done"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "更新后的任务",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Task"
                }
              }
            }
          },
          "401": {
            "description": "未登录或 token 已失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "任务不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "参数校验失败",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "tasks"
        ],
        "operationId": "deleteTask",
        "summary": "删除任务",
        "description": "只有创建人或管理员能删；老数据没有创建人，只有管理员能删。",
        "responses": {
          "204": {
            "description": "删除成功"
          },
          "401": {
            "description": "未登录或 token 已失效",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "不是创建人也不是管理员",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "任务不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "登录或注册返回的 token，请求头写 `Authorization: Bearer <token>`。"
      }
    },
    "schemas": {
      "UserRole": {
        "type": "string",
        "description": "角色：`member` 普通成员、`admin` 管理员（第一个注册的账号）",
        "enum": [
          "member",
          "admin"
        ],
        "example": "member"
      },
      "User": {
        "type": "object",
        "required": [
          "id",
          "username",
          "display_name",
          "role",
          "created_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "username": {
            "type": "string",
            "description": "登录账号，不区分大小写唯一",
            "example": "zhangsan"
          },
          "display_name": {
            "type": "string",
            "description": "显示名，默认与用户名相同",
            "example": "张三"
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "注册时间（UTC）",
            "example": "2026-01-31T09:30:00.123Z"
          }
        }
      },
      "RegisterRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 32,
            "pattern": "^[A-Za-z0-9_.-]+$",
            "description": "登录账号：3–32 位字母、数字、点、下划线或短横线",
            "example": "zhangsan"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "format": "password",
            "description": "密码，至少 8 位",
            "example": "secret123"
          },
          "display_name": {
            "type": "string",
            "maxLength": 50,
            "description": "显示名，不传就用用户名",
            "example": "张三"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "username": {
            "type": "string",
            "example": "zhangsan"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "secret123"
          }
        }
      },
      "AuthResponse": {
        "type": "object",
        "required": [
          "token",
          "token_type",
          "expires_at",
          "user"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "登录态 token，存 localStorage，请求时放 Authorization 头",
            "example": "V1StGXR8_Z5jdHi6B-myT..."
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ],
            "example": "Bearer"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "description": "token 过期时间（UTC），过期后重新登录",
            "example": "2026-02-07T09:30:00.123Z"
          },
          "user": {
            "$ref": "#/components/schemas/User"
          }
        }
      },
      "UserList": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "total": {
            "type": "integer",
            "example": 3
          }
        }
      },
      "TaskStatus": {
        "type": "string",
        "description": "任务状态：`todo` 待办、`doing` 进行中、`done` 完成",
        "enum": [
          "todo",
          "doing",
          "done"
        ],
        "example": "todo"
      },
      "TaskPriority": {
        "type": "string",
        "description": "优先级：`low` 低、`medium` 中、`high` 高",
        "enum": [
          "low",
          "medium",
          "high"
        ],
        "example": "medium"
      },
      "Task": {
        "type": "object",
        "required": [
          "id",
          "title",
          "assignee",
          "priority",
          "status",
          "created_by",
          "creator",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "标题",
            "example": "把登录页的联调做完"
          },
          "assignee": {
            "type": "string",
            "description": "负责人",
            "example": "张三"
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          },
          "created_by": {
            "type": "integer",
            "nullable": true,
            "description": "创建人用户 id；加登录之前的老数据为 null",
            "example": 1
          },
          "creator": {
            "type": "string",
            "nullable": true,
            "description": "创建人用户名；加登录之前的老数据为 null",
            "example": "zhangsan"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "description": "创建时间（UTC）",
            "example": "2026-01-31T09:30:00.123Z"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "description": "最后更新时间（UTC）",
            "example": "2026-01-31T10:00:05.456Z"
          }
        }
      },
      "TaskCreate": {
        "type": "object",
        "required": [
          "title",
          "assignee"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "标题，去首尾空格后不能为空",
            "example": "把登录页的联调做完"
          },
          "assignee": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50,
            "description": "负责人，去首尾空格后不能为空",
            "example": "张三"
          },
          "priority": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TaskPriority"
              }
            ],
            "default": "medium"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/TaskStatus"
              }
            ],
            "default": "todo"
          }
        }
      },
      "TaskUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "assignee": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "priority": {
            "$ref": "#/components/schemas/TaskPriority"
          },
          "status": {
            "$ref": "#/components/schemas/TaskStatus"
          }
        }
      },
      "TaskList": {
        "type": "object",
        "required": [
          "items",
          "total"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Task"
            }
          },
          "total": {
            "type": "integer",
            "example": 3
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
