[Unit]
Description=Team Task Board API
After=network.target

[Service]
Type=simple
User=teamtasks
Group=teamtasks
WorkingDirectory=/opt/team-tasks-backend
Environment=HOST=0.0.0.0
Environment=PORT=80
Environment=DB_PATH=/var/lib/team-tasks/tasks.db
Environment=FRONTEND_DIR=/var/www/team-tasks
ExecStart=/usr/bin/python3 /opt/team-tasks-backend/app.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/team-tasks
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
